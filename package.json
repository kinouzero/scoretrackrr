{
  "name": "scoretrackrr",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26 <27"
  },
  "imports": {
    "#lib/*.svelte": "./src/lib/*.svelte",
    "#lib/*": "./src/lib/*.ts"
  },
  "scripts": {
    "dev": "vite dev --host 127.0.0.1",
    "build": "pnpm check:i18n && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "pnpm check:i18n && pnpm check:docs && node scripts/engine-validators.mjs --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p src/service-worker/tsconfig.json",
    "generate:engine": "node scripts/engine-validators.mjs",
    "lint": "eslint . && prettier --check src tests scripts *.json *.ts *.js compose*.yaml .github/workflows/*.yml",
    "format": "prettier --write src tests scripts *.json *.ts *.js compose*.yaml .github/workflows/*.yml",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "coverage": "node scripts/run-coverage.mjs",
    "coverage:report": "node scripts/coverage-report.mjs",
    "test:e2e": "playwright test",
    "check:i18n": "node scripts/check-i18n.mjs",
    "docs:screenshots": "node scripts/capture-docs.mjs",
    "generate:icons": "node scripts/generate-icons.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "bench": "vitest bench --run --reporter=verbose",
    "bench:storage": "node scripts/benchmark-storage.mjs"
  },
  "dependencies": {
    "dexie": "4.4.7",
    "intl-messageformat": "12.1.5",
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@bcoe/v8-coverage": "1.0.2",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "1.65.1",
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.2.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "5.1.0",
    "ajv": "8.20.0",
    "ast-v8-to-istanbul": "1.0.8",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.24.1",
    "fake-indexeddb": "6.2.8",
    "globals": "17.14.0",
    "monocart-coverage-reports": "3.2.1",
    "prettier": "^3.0.0",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.5",
    "typescript": "^6.0.0",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "license": "MIT"
}

# Copy this file to .env next to the root Compose files.
# Docker hostname or network alias for the relay, on the app's network.
GRANBOARD_HOST=granboard
GRANBOARD_ADDRESS=
# Address of the trusted HTTPS proxy as seen by the app container.
GRANBOARD_TRUSTED_PROXY=
# Client subnet that may use the relay, for example 192.168.1.0/24.
GRANBOARD_LAN_CIDR=
# Set these IDs to the Linux account allowed to use BlueZ on the system bus.
GRANBOARD_UID=1000
GRANBOARD_GID=1000

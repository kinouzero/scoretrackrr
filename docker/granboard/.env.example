# Copy this file to .env next to the root Compose files.
# Docker hostname or network alias for the relay, on the app's network.
GRANBOARD_HOST=granboard
GRANBOARD_ADDRESS=
# Generate a private value with: openssl rand -hex 24
GRANBOARD_PAIRING_CODE=
# Set these IDs to the Linux account allowed to use BlueZ on the system bus.
GRANBOARD_UID=1000
GRANBOARD_GID=1000
